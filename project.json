{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "factman",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "data:validate": {
      "command": "tsx scripts/data/validate.ts",
      "cache": true,
      "inputs": ["data"]
    },
    "data:types": {
      "command": "tsx scripts/data/generate-types.ts",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/data/schemas/**/*",
        "{projectRoot}/scripts/data/**/*.ts",
        "sharedGlobals"
      ],
      "outputs": ["{projectRoot}/src/app/shared/models/generated"]
    },
    "sync:github": {
      "command": "tsx scripts/github/sync-github.ts"
    },
    "data:hero-code": {
      "command": "tsx scripts/data/generate-hero-code.ts"
    },
    "data:docs": {
      "command": "tsx scripts/data/generate-docs.ts",
      "inputs": ["{projectRoot}/src/data/schemas/**/*", "{projectRoot}/scripts/data/**/*.ts"],
      "outputs": ["{projectRoot}/docs/data-reference.md"],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["data:validate", "data:types"],
      "inputs": [
        "{projectRoot}/scripts/resume/**/*",
        "{projectRoot}/public/resumes/**/*",
        { "env": "VERCEL_ENV" },
        "production",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        "{projectRoot}/tools/build/not-found-page.mjs",
        "{projectRoot}/tools/build/seo-files.mjs"
      ],
      "outputs": ["{projectRoot}/dist/factman"],
      "options": {
        "command": "tsx scripts/resume/check-resumes.ts && ng build && node tools/build/not-found-page.mjs && BUILD_VARIANT=production node tools/build/seo-files.mjs"
      }
    },
    "build-preview": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["data:validate", "data:types", "build-storybook"],
      "inputs": [
        "{projectRoot}/scripts/resume/**/*",
        "{projectRoot}/public/resumes/**/*",
        { "env": "VERCEL_ENV" },
        "production",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        "{projectRoot}/tools/build/add-storybook.mjs",
        "{projectRoot}/tools/build/not-found-page.mjs",
        "{projectRoot}/tools/build/seo-files.mjs"
      ],
      "outputs": ["{projectRoot}/dist/factman"],
      "options": {
        "command": "tsx scripts/resume/check-resumes.ts && ng build --configuration production,preview && node tools/build/not-found-page.mjs && BUILD_VARIANT=preview node tools/build/seo-files.mjs && node tools/build/add-storybook.mjs"
      }
    },
    "watch": {
      "command": "ng build --watch --configuration development",
      "dependsOn": ["data:types"],
      "continuous": true
    },
    "start": {
      "command": "ng serve",
      "dependsOn": ["data:types"],
      "continuous": true
    },
    "serve:ssr:factman": {
      "command": "node dist/factman/server/server.mjs",
      "dependsOn": ["build"],
      "continuous": true
    },
    "test": {
      "command": "ng test",
      "dependsOn": ["data:validate", "data:types"],
      "inputs": ["source", "!{projectRoot}/e2e/**/*"]
    },
    "test:storybook": {
      "command": "vitest run --project storybook",
      "dependsOn": ["data:types"],
      "cache": true,
      "inputs": ["source", "!{projectRoot}/e2e/**/*"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["data:validate", "data:types"],
      "cache": true,
      "inputs": ["source", "!{projectRoot}/e2e/**/*"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/coverage-raw"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf coverage coverage-raw",
          "ng test --watch=false --coverage --coverage-reporters=json --coverage-reporters=text-summary",
          "mkdir -p coverage-raw && mv coverage/factman coverage-raw/unit",
          "vitest run --project storybook --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=text-summary --coverage.reportsDirectory=coverage-raw/storybook --coverage.include='src/app/**/*.ts' --coverage.exclude='**/*.stories.ts' --coverage.exclude='**/*.spec.ts'",
          "node tools/reports/merge-coverage.mjs"
        ]
      }
    },
    "test:scripts": {
      "command": "node --import tsx --test --test-reporter=spec \"scripts/**/*.test.ts\"",
      "cache": true,
      "inputs": [
        "source",
        "{projectRoot}/docs/component-inventory.md",
        "{projectRoot}/docs/data-reference.md",
        "{projectRoot}/docs/interaction-and-motion.md"
      ]
    },
    "test:lint-rules": {
      "command": "node --test --test-reporter=spec tools/eslint/boundaries.test.mjs",
      "cache": true,
      "inputs": [
        "{projectRoot}/tools/eslint/**/*",
        "{projectRoot}/eslint.config.mjs",
        "sharedGlobals"
      ]
    },
    "test:headers": {
      "command": "node --test --test-reporter=spec tools/vercel/headers.test.mjs",
      "cache": true,
      "inputs": ["{projectRoot}/tools/vercel/**/*", "{projectRoot}/vercel.json", "sharedGlobals"]
    },
    "test:reports": {
      "command": "node --test --test-reporter=spec \"tools/reports/*.test.mjs\"",
      "cache": true,
      "inputs": ["{projectRoot}/tools/reports/**/*", "sharedGlobals"]
    },
    "test:build": {
      "command": "BUILD_VARIANT=preview node --test --test-reporter=spec \"tools/build/*.test.mjs\"",
      "dependsOn": ["build-preview"],
      "cache": true,
      "inputs": [
        "{projectRoot}/tools/build/**/*",
        "{projectRoot}/src/data/**/*.json",
        "{projectRoot}/vercel.json",
        {
          "dependentTasksOutputFiles": "**/*.{js,html}"
        }
      ]
    },
    "test:build-production": {
      "command": "BUILD_VARIANT=production node --test --test-reporter=spec \"tools/build/*.test.mjs\"",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "{projectRoot}/tools/build/**/*",
        "{projectRoot}/src/data/**/*.json",
        "{projectRoot}/vercel.json",
        {
          "dependentTasksOutputFiles": "**/*.{js,html}"
        }
      ]
    },
    "csp:hashes": {
      "command": "node tools/build/csp-hashes.mjs",
      "dependsOn": ["build-preview"]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "lint:styles", "test:lint-rules"]
    },
    "lint:eslint": {
      "command": "eslint .",
      "cache": true,
      "inputs": ["source"]
    },
    "lint:styles": {
      "command": "stylelint \"src/**/*.{css,scss}\"",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.{css,scss}",
        "{projectRoot}/.stylelintrc.json",
        "sharedGlobals"
      ]
    },
    "lint:fix": {
      "command": "eslint . --fix"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["data:types"],
      "inputs": ["source"],
      "options": {
        "parallel": false,
        "commands": [
          "tsc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit",
          "tsc -p tsconfig.scripts.json --noEmit"
        ]
      }
    },
    "format": {
      "command": "prettier --write ."
    },
    "format:check": {
      "command": "prettier --check .",
      "cache": true,
      "inputs": ["default"]
    },
    "storybook": {
      "command": "ng run factman:storybook",
      "dependsOn": ["data:types"],
      "continuous": true
    },
    "build-storybook": {
      "command": "ng run factman:build-storybook",
      "dependsOn": ["data:types"],
      "cache": true,
      "inputs": ["source", "!{projectRoot}/e2e/**/*"],
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "e2e": {
      "command": "playwright test",
      "dependsOn": ["build-preview"],
      "cache": false
    },
    "e2e-production": {
      "command": "E2E_VARIANT=production playwright test",
      "dependsOn": ["build"],
      "cache": false
    },
    "e2e:report": {
      "command": "playwright merge-reports --reporter html blob-report",
      "cache": false
    },
    "e2e:install": {
      "command": "playwright install --with-deps"
    },
    "ds:tokens": {
      "command": "tsx scripts/design-system/build-tokens.ts"
    },
    "ds:split": {
      "command": "tsx scripts/design-system/split-components.ts"
    },
    "ds:fonts": {
      "command": "tsx scripts/design-system/build-fonts.ts"
    },
    "ds:brand": {
      "command": "tsx scripts/design-system/build-brand.ts"
    },
    "ds:portraits": {
      "command": "tsx scripts/design-system/build-portraits.ts"
    },
    "ds:og": {
      "command": "tsx scripts/design-system/build-og.ts"
    },
    "ds:icons": {
      "command": "tsx scripts/design-system/build-icons.ts"
    },
    "vr": {
      "command": "playwright test -c playwright.vr.config.ts",
      "dependsOn": ["build-preview"],
      "cache": false
    },
    "vr:update": {
      "command": "playwright test -c playwright.vr.config.ts --update-snapshots",
      "dependsOn": ["build-preview"],
      "cache": false
    },
    "build:resumes": {
      "command": "tsx scripts/resume/build-resumes.ts"
    },
    "resume:check": {
      "command": "tsx scripts/resume/check-resumes.ts"
    },
    "resume:html": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/data/**/*",
        "{projectRoot}/scripts/resume/**/*",
        "{projectRoot}/src/app/shared/resume/**/*"
      ],
      "outputs": ["{projectRoot}/dist/resumes"],
      "options": {
        "command": "node --import tsx scripts/resume/render-html.ts"
      }
    }
  }
}
