{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/skills.schema.json",
  "title": "Skills",
  "description": "Technologies, grouped by area (PRD FR-11, FR-12). Years are computed from `since`, so they never go stale.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/skill"
  },
  "$defs": {
    "skill": {
      "title": "Skill",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "featured", "icon", "tracks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["Languages", "Frontend", "Backend", "Mobile", "Data", "Cloud & DevOps", "Tools"]
        },
        "since": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100,
          "description": "First year of use; shown as current year - since. Omit when unknown."
        },
        "level": {
          "enum": ["expert", "advanced", "intermediate"],
          "description": "Optional self-rating."
        },
        "featured": {
          "type": "boolean",
          "description": "Shown first in its group."
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Design-system icon name."
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["fullstack", "mobile", "devops"]
          },
          "description": "Résumés the skill appears on (resumes.json ids)."
        }
      }
    }
  }
}
