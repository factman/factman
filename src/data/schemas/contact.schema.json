{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/contact.schema.json",
  "title": "Contact",
  "description": "How to reach the owner (PRD FR-27 to FR-30). City and country only: a street address is never stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email",
    "phone",
    "whatsapp",
    "links",
    "responseTime",
    "timezone",
    "city",
    "country"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Plain address; pages build the mailto: link."
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "description": "E.164 (DS-11). Shown only after a click (PhoneReveal)."
    },
    "whatsapp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "message"],
      "properties": {
        "number": {
          "type": "string",
          "pattern": "^\\d{7,15}$",
          "description": "Digits only, country code first, as wa.me expects (DS-11)."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Prefilled first message."
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "responseTime": {
      "type": "string",
      "minLength": 1,
      "description": "Shown as written, e.g. \"within 24 hours\"."
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z]+/[A-Za-z_]+$",
      "description": "IANA time zone; pages show its abbreviation and offset (WAT · UTC+1)."
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "handle"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "description": "What the link shows, e.g. @factman60."
        }
      }
    }
  }
}
