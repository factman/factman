{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/projects.schema.json",
  "title": "Projects",
  "description": "Projects for the gallery and /projects/:slug (PRD FR-20 to FR-23). Private projects show the role and stack and never link out.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/project"
  },
  "$defs": {
    "project": {
      "title": "Project",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "category",
        "status",
        "visibility",
        "featured",
        "stack",
        "startedAt",
        "links",
        "tracks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "URL segment: /projects/<slug>."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["completed", "in-progress", "maintained", "archived"]
        },
        "visibility": {
          "enum": ["public", "private"]
        },
        "featured": {
          "type": "boolean",
          "description": "On the home grid; at most 6 (DS-08)."
        },
        "stack": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": "Skill ids from skills.json (DS-05)."
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
        },
        "completedAt": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
        },
        "cover": {
          "type": "string",
          "pattern": "^projects/[a-z0-9-]+/[a-z0-9-]+\\.(webp|png|jpe?g|avif|svg)$"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^projects/[a-z0-9-]+/[a-z0-9-]+\\.(webp|png|jpe?g|avif|svg)$"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "live": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "source": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "caseStudy": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "engage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "note"],
          "properties": {
            "mode": {
              "enum": ["request-access", "request-demo", "contact"]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["fullstack", "mobile", "devops"]
          }
        }
      },
      "if": {
        "properties": {
          "visibility": {
            "const": "private"
          }
        }
      },
      "then": {
        "required": ["engage"],
        "properties": {
          "engage": true
        }
      },
      "$comment": "A private project needs `engage`; its no-links rule is DS-07 in scripts/data/rules.ts."
    }
  }
}
