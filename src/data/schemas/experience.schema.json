{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.factman.dev/schemas/experience.schema.json",
  "title": "Experience",
  "description": "Work history: organizations with their roles (PRD FR-13 to FR-16). The timeline orders roles itself (current first, then newest), so file order doesn't matter. Each résumé picks its roles in resumes.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/organization"
  },
  "$defs": {
    "organization": {
      "title": "Organization",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization", "roles"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "description": "Display name on the site, e.g. Simple Finance."
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "description": "Name on the résumés when it differs, e.g. Simple Finance Company Limited."
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "logo": {
          "type": "string",
          "pattern": "^clients/[a-z0-9-]+\\.(png|svg|webp)$",
          "description": "Under src/assets (shared with clients.json)."
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "role": {
      "title": "Role",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "start", "summary", "highlights", "skills"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["full-time", "part-time", "contract", "freelance", "internship"]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
          "description": "YYYY-MM, or a bare YYYY when the month isn't known."
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
          "description": "No end means the role is current."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "One line for a résumé's \"Earlier experience\" list."
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": "Skill ids from skills.json (DS-05)."
        }
      }
    },
    "highlight": {
      "description": "A string is shown on the site and on any résumé that has no bullets of its own for the role. An object with tracks is shown only on those résumés (resumes.json ids), in place of the strings.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "tracks"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      ]
    }
  }
}
