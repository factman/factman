{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/experience.schema.json",
  "title": "Experience",
  "description": "Work history: organizations with their roles (PRD FR-13 to FR-16). The timeline orders roles itself (current first, then newest), so file order doesn't matter.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/organization"
  },
  "$defs": {
    "organization": {
      "title": "Organization",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization", "roles"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "logo": {
          "type": "string",
          "pattern": "^clients/[a-z0-9-]+\\.(png|svg|webp)$",
          "description": "Under src/assets (shared with clients.json)."
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "role": {
      "title": "Role",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "start", "summary", "highlights", "skills", "tracks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["full-time", "part-time", "contract", "freelance", "internship"]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "description": "No end means the role is current."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": "Skill ids from skills.json (DS-05)."
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["fullstack", "mobile", "devops"]
          }
        }
      }
    },
    "highlight": {
      "description": "A string is shown on every résumé; an object only on its tracks.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "tracks"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["fullstack", "mobile", "devops"]
              }
            }
          }
        }
      ]
    }
  }
}
