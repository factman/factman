{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/blog.schema.json",
  "title": "Blog",
  "description": "Articles for the Writing section and /blog (PRD FR-24 to FR-26). `pnpm sync:medium` adds the Medium posts (origin rss); posts added by hand use origin manual and are never changed by the sync.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/post"
  },
  "$defs": {
    "post": {
      "title": "Post",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "title",
        "publishedAt",
        "tags",
        "excerpt",
        "readingMinutes",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "The Medium slug without its hash."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://medium\\.com/",
          "description": "Medium URLs only."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "cover": {
          "type": "string",
          "pattern": "^blog/[a-z0-9-]+\\.(webp|png|jpe?g|avif)$",
          "description": "Under src/assets (stored locally, never hotlinked)."
        },
        "readingMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "enum": ["manual", "rss"]
        }
      }
    }
  }
}
