{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factman.vercel.app/schemas/profile.schema.json",
  "title": "Profile",
  "description": "Who the owner is: hero, About section and résumé header (PRD FR-07 to FR-10, FR-50). No street address.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "headline",
    "roles",
    "summary",
    "about",
    "location",
    "photo",
    "careerStart",
    "availability",
    "languages",
    "education",
    "publications",
    "updatedAt"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Rotating hero line (typewriter)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Hero lead paragraph."
    },
    "about": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "First-person About story, one paragraph each."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "country"],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "photo": {
      "$ref": "#/$defs/photo",
      "description": "Hero portrait (FR-50)."
    },
    "aboutPhoto": {
      "$ref": "#/$defs/photo",
      "description": "About section portrait (PortraitPlate)."
    },
    "contactPhoto": {
      "$ref": "#/$defs/photo",
      "description": "Contact section photo (ContactPhoto)."
    },
    "careerStart": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "First month of professional work; years of experience are computed from it (FR-11)."
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message"],
      "properties": {
        "status": {
          "enum": ["available", "limited", "unavailable"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "proficiency"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "proficiency": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "start", "end"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1950
          },
          "end": {
            "type": "integer",
            "minimum": 1950
          }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "year"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1950
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD; drives the résumé PDF metadata."
    }
  },
  "$defs": {
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "width", "height"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^profile/[a-z0-9-]+\\.(webp|jpe?g|png|avif)$",
          "description": "Under src/assets (DS-17: must exist)."
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixel width of the file (DS-17)."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixel height of the file (DS-17)."
        }
      }
    }
  }
}
