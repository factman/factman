exports[`the résumé template > devops: matches its snapshot 1`] = `
"<!doctype html>\\n<html lang=\\"en\\">\\n<head>\\n<meta charset=\\"utf-8\\">\\n<title>Odunayo Mohammed · DevOps / Cloud Engineer</title>\\n<meta name=\\"author\\" content=\\"Odunayo Mohammed\\">\\n<meta name=\\"robots\\" content=\\"noindex\\">\\n<style>/* The résumé layout (ETE-107, ported from the canvas's resume.css, ETE-223).\\n   A4, 15 / 17 / 16 mm margins. Carlito (metric-compatible with Calibri) for text, Caladea\\n   (metric-compatible with Cambria) for headings; both self-hosted, with system fallbacks.\\n   Fixed colours: a résumé always prints light. One column of real text, so it extracts in reading\\n   order. In print, the page boxes carry the footer (name, role, \\"Page x of y\\") on every page and\\n   the running header from page 2; the template writes their text (pageCss in template.ts). */\\n@page {\\n  size: a4;\\n  margin: 15mm 17mm 16mm;\\n\\n  @top-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-right {\\n    content: 'Page ' counter(page) ' of ' counter(pages);\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n}\\n\\n/* The first page opens with the name in full; the running header starts on page 2. */\\n@page :first {\\n  @top-left {\\n    content: none;\\n  }\\n}\\n\\n:root {\\n  --cv-ink: #07203f;\\n  --cv-text: #1f2b40;\\n  --cv-muted: #4a5a72;\\n  --cv-faint: #64768f;\\n  --cv-rule: #d3dce9;\\n  --cv-accent: #0b4c9e;\\n}\\n\\nhtml {\\n  background: #dde5ef;\\n}\\n\\nbody {\\n  margin: 0;\\n}\\n\\n.cv-doc {\\n  box-sizing: border-box;\\n  width: 210mm;\\n  min-height: 297mm;\\n  margin: 32px auto;\\n  padding: 15mm 17mm 16mm;\\n  background: #fff;\\n  color: var(--cv-text);\\n  box-shadow:\\n    0 16px 40px -8px rgb(7 32 63 / 18%),\\n    0 2px 8px rgb(7 32 63 / 8%);\\n  border-top: 2.2mm solid var(--cv-accent);\\n  font:\\n    400 10pt/1.38 Carlito,\\n    Calibri,\\n    'Helvetica Neue',\\n    Arial,\\n    sans-serif;\\n  -webkit-font-smoothing: antialiased;\\n  text-rendering: optimizelegibility;\\n}\\n\\n.cv-doc p,\\n.cv-doc ul,\\n.cv-doc h1,\\n.cv-doc h2,\\n.cv-doc h3,\\n.cv-doc dl {\\n  margin: 0;\\n}\\n\\n/* Header */\\n.cv-head {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  align-items: end;\\n  gap: 2mm 8mm;\\n  padding-bottom: 3.2mm;\\n  border-bottom: 0.75pt solid var(--cv-accent);\\n}\\n\\n.cv-name {\\n  font:\\n    700 25pt/1.05 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.2pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-role {\\n  margin-top: 1.4mm;\\n  font:\\n    700 10.5pt/1.3 Carlito,\\n    Calibri,\\n    Arial,\\n    sans-serif;\\n  letter-spacing: 0.9pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n}\\n\\n.cv-contact {\\n  grid-column: 1 / -1;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5mm;\\n  font-size: 9.2pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-contact__line {\\n  display: flex;\\n  flex-wrap: wrap;\\n}\\n\\n.cv-contact__line span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-contact a {\\n  color: inherit;\\n  text-decoration: none;\\n}\\n\\n/* Sections */\\n.cv-sec {\\n  margin-top: 4.2mm;\\n}\\n\\n.cv-h {\\n  display: flex;\\n  align-items: center;\\n  gap: 3mm;\\n  margin-bottom: 2.2mm;\\n  font:\\n    700 10.5pt/1.2 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.8pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n  break-after: avoid;\\n}\\n\\n.cv-h::after {\\n  content: '';\\n  flex: 1;\\n  height: 0;\\n  border-top: 0.5pt solid var(--cv-rule);\\n}\\n\\n.cv-summary {\\n  font-size: 10.3pt;\\n  line-height: 1.45;\\n  text-align: justify;\\n  hyphens: auto;\\n}\\n\\n.cv-skills {\\n  display: grid;\\n  grid-template-columns: 31mm 1fr;\\n  gap: 1.1mm 4mm;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-skills dt {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-skills dd {\\n  margin: 0;\\n}\\n\\n/* Experience */\\n.cv-org {\\n  margin-top: 2.8mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-org:first-of-type {\\n  margin-top: 0;\\n}\\n\\n.cv-org__head,\\n.cv-job__head,\\n.cv-proj__head {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  gap: 4mm;\\n}\\n\\n.cv-org__name {\\n  font-weight: 700;\\n  font-size: 10.6pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-org__meta,\\n.cv-job__dates,\\n.cv-row__dates {\\n  font-size: 9pt;\\n  color: var(--cv-muted);\\n  white-space: nowrap;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.cv-job {\\n  margin-top: 1.2mm;\\n}\\n\\n.cv-job__title {\\n  font-style: italic;\\n  font-weight: 700;\\n  color: var(--cv-accent);\\n  font-size: 10pt;\\n}\\n\\n.cv-list {\\n  list-style: none;\\n  padding: 0;\\n  margin-top: 0.9mm;\\n}\\n\\n.cv-list li {\\n  position: relative;\\n  padding-left: 4mm;\\n  margin-top: 0.55mm;\\n}\\n\\n.cv-list li::before {\\n  content: '';\\n  position: absolute;\\n  left: 0.6mm;\\n  top: 0.62em;\\n  width: 1.3mm;\\n  height: 1.3mm;\\n  background: var(--cv-accent);\\n  transform: rotate(45deg);\\n}\\n\\n.cv-stack {\\n  margin-top: 0.7mm;\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-stack b {\\n  font-weight: 700;\\n  color: var(--cv-muted);\\n}\\n\\n/* Earlier roles, clients and projects */\\n.cv-rows {\\n  display: grid;\\n  gap: 1.2mm;\\n}\\n\\n.cv-row {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  gap: 0 4mm;\\n  align-items: baseline;\\n  break-inside: avoid;\\n}\\n\\n.cv-row__main b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-row__note {\\n  grid-column: 1 / -1;\\n  font-size: 9.3pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-clients {\\n  display: flex;\\n  flex-wrap: wrap;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-clients span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-proj {\\n  break-inside: avoid;\\n}\\n\\n.cv-proj + .cv-proj {\\n  margin-top: 1.8mm;\\n}\\n\\n.cv-proj__name {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-proj__tech {\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n  white-space: nowrap;\\n}\\n\\n/* Closing columns: education, languages, publications */\\n.cv-cols {\\n  display: grid;\\n  grid-template-columns: 1.15fr 0.85fr 1.3fr;\\n  gap: 0 6mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-small {\\n  font-size: 9.4pt;\\n}\\n\\n.cv-small b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-muted {\\n  color: var(--cv-muted);\\n}\\n\\n/* An owner placeholder still to fill: highlighted on screen previews, plain in print. */\\n.cv-ph {\\n  padding: 0 0.6mm;\\n  border-radius: 0.6mm;\\n  background: #fbebcf;\\n  color: #784708;\\n  font-weight: 700;\\n  white-space: nowrap;\\n}\\n\\n/* \\"Experience, continued\\" (pnpm build:resumes): starts the page an Experience section runs onto. */\\n.cv-continued {\\n  break-before: page;\\n}\\n\\n@media print {\\n  html {\\n    background: none;\\n  }\\n\\n  .cv-doc {\\n    width: auto;\\n    min-height: 0;\\n    margin: 0;\\n    padding: 0;\\n    box-shadow: none;\\n    border-top: 0;\\n  }\\n\\n  .cv-ph {\\n    padding: 0;\\n    background: none;\\n    color: inherit;\\n    font-weight: inherit;\\n  }\\n}\\n@page{@top-left{content:\\"Odunayo Mohammed · DevOps / Cloud Engineer résumé\\"}@bottom-left{content:\\"Odunayo Mohammed · DevOps / Cloud Engineer\\"}}@page:first{@top-left{content:none}}</style>\\n</head>\\n<body>\\n<article class=\\"cv-doc\\" aria-label=\\"DevOps / Cloud Engineer résumé\\">\\n<header class=\\"cv-head\\"><div><h1 class=\\"cv-name\\">Odunayo Mohammed</h1><p class=\\"cv-role\\">DevOps / Cloud Engineer</p></div>\\n<div class=\\"cv-contact\\"><p class=\\"cv-contact__line\\"><span>Lagos, Nigeria</span><span><a href=\\"tel:+2347066780373\\">+234 706 678 0373</a></span><span><a href=\\"mailto:factman60@gmail.com\\">factman60@gmail.com</a></span></p><p class=\\"cv-contact__line\\"><span><a href=\\"https://www.linkedin.com/in/mohammed-odunayo\\">linkedin.com/in/mohammed-odunayo</a></span><span><a href=\\"https://github.com/factman\\">github.com/factman</a></span><span><a href=\\"https://www.factman.dev\\">factman.dev</a></span></p></div></header>\\n<section class=\\"cv-sec cv-sec--profile\\"><h2 class=\\"cv-h\\">Profile</h2>\\n<p class=\\"cv-summary\\">DevOps and cloud engineer and CTO with 13+ years in software, building the CI/CD pipelines, containers and cloud infrastructure that let teams ship safely and often. Works across AWS, Google Cloud and Microsoft Azure with Docker, Kubernetes, Jenkins and Azure DevOps, and brings a developer’s view of the systems being deployed (Node.js, Angular, TypeScript). Has owned production operations, network administration, information security and technology budgets.</p>\\n</section>\\n<section class=\\"cv-sec cv-sec--skills\\"><h2 class=\\"cv-h\\">Core skills</h2>\\n<dl class=\\"cv-skills\\"><dt>Cloud</dt><dd>Amazon Web Services, Google Cloud, Microsoft Azure, DigitalOcean, Heroku, Vercel</dd><dt>Containers</dt><dd>Docker, Docker Compose, Kubernetes</dd><dt>CI/CD</dt><dd>Jenkins, Azure DevOps, GitHub Actions, trunk-based Git workflows, automated testing gates</dd><dt>Systems</dt><dd>Linux (Ubuntu Server), Bash, Nginx, networking, backups and recovery</dd><dt>Operations</dt><dd>Monitoring and alerting, incident response, information security management, cost control</dd><dt>Development</dt><dd>Node.js, TypeScript, Python, PHP, PostgreSQL, MySQL, MongoDB, Elasticsearch</dd></dl>\\n</section>\\n<section class=\\"cv-sec cv-sec--experience\\"><h2 class=\\"cv-h\\">Experience</h2>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Simple Finance Company Limited</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Jan 2024 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Own the company’s cloud infrastructure and deployment pipeline, and the selection and roll-out of new systems.</li><li>Moved web and API services to containerised deployments with automated CI/CD, cutting release time from manual deployments to automated pipeline releases.</li><li>Keep production platforms reliable and secure for a regulated finance business with high availability.</li><li>Plan and manage the technology budget and projects with senior leadership.</li></ul></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Jan 2023</span></div>\\n<ul class=\\"cv-list\\"><li>Led the technology team; chose and deployed the core systems and infrastructure.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · Docker · AWS · CI/CD · Linux · PostgreSQL</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">ETeam Technology</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">CTO &amp; Co-Founder</span><span class=\\"cv-job__dates\\">May 2017 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Oversee production operations, network and systems administration, technical support and information security management.</li><li>Standardised Docker-based environments and CI/CD pipelines across client projects on AWS, Azure and DigitalOcean for multiple services.</li><li>Set up monitoring, backups and incident response for client platforms in production.</li><li>Own the technology budget and infrastructure spend, reducing hosting costs by right-sizing infrastructure.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · Docker · Kubernetes · AWS · Azure · DigitalOcean · Jenkins</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Mazadat</span><span class=\\"cv-org__meta\\">Cairo, Egypt</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Frontend Lead Engineer · Senior Frontend Engineer</span><span class=\\"cv-job__dates\\">Apr 2023 – Mar 2024</span></div>\\n<ul class=\\"cv-list\\"><li>Worked in the delivery pipeline on Microsoft Azure with Docker and Jenkins for the marketplace frontend.</li><li>Led frontend engineering and streamlined the development process with cross-functional teams.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · Azure · Docker · Jenkins · Elasticsearch · MongoDB</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Afe Babalola University</span><span class=\\"cv-org__meta\\">Ado-Ekiti, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Information Technology Support Specialist</span><span class=\\"cv-job__dates\\">2018 – Oct 2020</span></div>\\n<ul class=\\"cv-list\\"><li>Supported hardware, software and systems for faculty, staff and students, including installation, troubleshooting and maintenance.</li><li>Evaluated and deployed new systems and infrastructure with technology vendors.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Travoofy</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Aug 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Evaluated and deployed new systems and infrastructure; supervised timely resolution of IT issues.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Investa.ng</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Engineering Manager</span><span class=\\"cv-job__dates\\">Jan 2021 – Jan 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Managed engineering and technology resources in line with growth targets; delivered projects on time and on budget.</li></ul></div>\\n</section>\\n</section>\\n<section class=\\"cv-sec cv-sec--earlier\\"><h2 class=\\"cv-h\\">Earlier experience</h2>\\n<div class=\\"cv-rows\\"><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Information Technology Consultant</b>, Peace Mass Transit</span><span class=\\"cv-row__dates\\">Jul 2020 – Aug 2020</span><span class=\\"cv-row__note\\">Advised on new technology systems and resolved technical issues.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Senior Full Stack Developer</b>, Nano Blockchain Ltd</span><span class=\\"cv-row__dates\\">Jun 2018 – Nov 2018</span><span class=\\"cv-row__note\\">Angular, Material UI and React frontends; Node.js and PHP backends.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Web Developer and Designer</b>, JIT Solutions</span><span class=\\"cv-row__dates\\">Jan 2013 – Dec 2017</span><span class=\\"cv-row__note\\">Designed and built client websites with HTML, CSS and JavaScript.</span></div></div>\\n</section>\\n<section class=\\"cv-sec cv-sec--clients\\"><h2 class=\\"cv-h\\">Companies and clients</h2>\\n<p class=\\"cv-clients\\"><span>SunTrust Bank</span><span>Gifti App</span><span>AirtimeFlip</span><span>Appiawave</span><span>Internopay</span><span>Circo</span><span>Cloudax</span></p>\\n</section>\\n<section class=\\"cv-sec cv-sec--projects\\"><h2 class=\\"cv-h\\">Selected projects</h2>\\n<div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Factman portfolio pipeline</span><span class=\\"cv-proj__tech\\">GitHub Actions · Vercel</span></div><p>Trunk-based CI/CD with build, test and preview deploys, plus scheduled jobs for content sync, link checks and résumé rebuilds.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Ubuntu Server Setup</span><span class=\\"cv-proj__tech\\">Bash · Linux</span></div><p>A script that sets up a fresh Ubuntu server and installs the applications it needs, with no hassle.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Covid-19 Daily Update API</span><span class=\\"cv-proj__tech\\">Node.js · Docker</span></div><p>Open-source API serving daily COVID-19 figures to a mobile app and public clients.</p></div>\\n</section>\\n<div class=\\"cv-cols\\"><section class=\\"cv-sec cv-sec--education\\"><h2 class=\\"cv-h\\">Education</h2>\\n<p class=\\"cv-small\\"><b>Computer Software Engineering</b><br>FirstMark Innovation School of Technology<br><span class=\\"cv-muted\\">2013 – 2015</span></p>\\n</section><section class=\\"cv-sec cv-sec--languages\\"><h2 class=\\"cv-h\\">Languages</h2>\\n<p class=\\"cv-small\\"><b>English</b> <span class=\\"cv-muted\\">· Professional working</span><br><b>Yoruba</b> <span class=\\"cv-muted\\">· Native</span></p>\\n</section><section class=\\"cv-sec cv-sec--publications\\"><h2 class=\\"cv-h\\">Publications</h2>\\n<p class=\\"cv-small\\"><b>Coronavirus Daily Update</b> <span class=\\"cv-muted\\">· mobile app, 2020</span><br><b>Covid-19 Daily Update API</b> <span class=\\"cv-muted\\">· open source, 2020</span><br><b>GraphUI</b> <span class=\\"cv-muted\\">· open source, 2019</span><br><span class=\\"cv-muted\\">Featured: \\"Nigerian engineer launches Coronavirus Daily Update mobile app\\"</span></p>\\n</section></div>\\n</article>\\n</body>\\n</html>\\n"
`;

exports[`the résumé template > fullstack: matches its snapshot 1`] = `
"<!doctype html>\\n<html lang=\\"en\\">\\n<head>\\n<meta charset=\\"utf-8\\">\\n<title>Odunayo Mohammed · Fullstack Software Engineer</title>\\n<meta name=\\"author\\" content=\\"Odunayo Mohammed\\">\\n<meta name=\\"robots\\" content=\\"noindex\\">\\n<style>/* The résumé layout (ETE-107, ported from the canvas's resume.css, ETE-223).\\n   A4, 15 / 17 / 16 mm margins. Carlito (metric-compatible with Calibri) for text, Caladea\\n   (metric-compatible with Cambria) for headings; both self-hosted, with system fallbacks.\\n   Fixed colours: a résumé always prints light. One column of real text, so it extracts in reading\\n   order. In print, the page boxes carry the footer (name, role, \\"Page x of y\\") on every page and\\n   the running header from page 2; the template writes their text (pageCss in template.ts). */\\n@page {\\n  size: a4;\\n  margin: 15mm 17mm 16mm;\\n\\n  @top-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-right {\\n    content: 'Page ' counter(page) ' of ' counter(pages);\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n}\\n\\n/* The first page opens with the name in full; the running header starts on page 2. */\\n@page :first {\\n  @top-left {\\n    content: none;\\n  }\\n}\\n\\n:root {\\n  --cv-ink: #07203f;\\n  --cv-text: #1f2b40;\\n  --cv-muted: #4a5a72;\\n  --cv-faint: #64768f;\\n  --cv-rule: #d3dce9;\\n  --cv-accent: #0b4c9e;\\n}\\n\\nhtml {\\n  background: #dde5ef;\\n}\\n\\nbody {\\n  margin: 0;\\n}\\n\\n.cv-doc {\\n  box-sizing: border-box;\\n  width: 210mm;\\n  min-height: 297mm;\\n  margin: 32px auto;\\n  padding: 15mm 17mm 16mm;\\n  background: #fff;\\n  color: var(--cv-text);\\n  box-shadow:\\n    0 16px 40px -8px rgb(7 32 63 / 18%),\\n    0 2px 8px rgb(7 32 63 / 8%);\\n  border-top: 2.2mm solid var(--cv-accent);\\n  font:\\n    400 10pt/1.38 Carlito,\\n    Calibri,\\n    'Helvetica Neue',\\n    Arial,\\n    sans-serif;\\n  -webkit-font-smoothing: antialiased;\\n  text-rendering: optimizelegibility;\\n}\\n\\n.cv-doc p,\\n.cv-doc ul,\\n.cv-doc h1,\\n.cv-doc h2,\\n.cv-doc h3,\\n.cv-doc dl {\\n  margin: 0;\\n}\\n\\n/* Header */\\n.cv-head {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  align-items: end;\\n  gap: 2mm 8mm;\\n  padding-bottom: 3.2mm;\\n  border-bottom: 0.75pt solid var(--cv-accent);\\n}\\n\\n.cv-name {\\n  font:\\n    700 25pt/1.05 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.2pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-role {\\n  margin-top: 1.4mm;\\n  font:\\n    700 10.5pt/1.3 Carlito,\\n    Calibri,\\n    Arial,\\n    sans-serif;\\n  letter-spacing: 0.9pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n}\\n\\n.cv-contact {\\n  grid-column: 1 / -1;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5mm;\\n  font-size: 9.2pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-contact__line {\\n  display: flex;\\n  flex-wrap: wrap;\\n}\\n\\n.cv-contact__line span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-contact a {\\n  color: inherit;\\n  text-decoration: none;\\n}\\n\\n/* Sections */\\n.cv-sec {\\n  margin-top: 4.2mm;\\n}\\n\\n.cv-h {\\n  display: flex;\\n  align-items: center;\\n  gap: 3mm;\\n  margin-bottom: 2.2mm;\\n  font:\\n    700 10.5pt/1.2 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.8pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n  break-after: avoid;\\n}\\n\\n.cv-h::after {\\n  content: '';\\n  flex: 1;\\n  height: 0;\\n  border-top: 0.5pt solid var(--cv-rule);\\n}\\n\\n.cv-summary {\\n  font-size: 10.3pt;\\n  line-height: 1.45;\\n  text-align: justify;\\n  hyphens: auto;\\n}\\n\\n.cv-skills {\\n  display: grid;\\n  grid-template-columns: 31mm 1fr;\\n  gap: 1.1mm 4mm;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-skills dt {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-skills dd {\\n  margin: 0;\\n}\\n\\n/* Experience */\\n.cv-org {\\n  margin-top: 2.8mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-org:first-of-type {\\n  margin-top: 0;\\n}\\n\\n.cv-org__head,\\n.cv-job__head,\\n.cv-proj__head {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  gap: 4mm;\\n}\\n\\n.cv-org__name {\\n  font-weight: 700;\\n  font-size: 10.6pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-org__meta,\\n.cv-job__dates,\\n.cv-row__dates {\\n  font-size: 9pt;\\n  color: var(--cv-muted);\\n  white-space: nowrap;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.cv-job {\\n  margin-top: 1.2mm;\\n}\\n\\n.cv-job__title {\\n  font-style: italic;\\n  font-weight: 700;\\n  color: var(--cv-accent);\\n  font-size: 10pt;\\n}\\n\\n.cv-list {\\n  list-style: none;\\n  padding: 0;\\n  margin-top: 0.9mm;\\n}\\n\\n.cv-list li {\\n  position: relative;\\n  padding-left: 4mm;\\n  margin-top: 0.55mm;\\n}\\n\\n.cv-list li::before {\\n  content: '';\\n  position: absolute;\\n  left: 0.6mm;\\n  top: 0.62em;\\n  width: 1.3mm;\\n  height: 1.3mm;\\n  background: var(--cv-accent);\\n  transform: rotate(45deg);\\n}\\n\\n.cv-stack {\\n  margin-top: 0.7mm;\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-stack b {\\n  font-weight: 700;\\n  color: var(--cv-muted);\\n}\\n\\n/* Earlier roles, clients and projects */\\n.cv-rows {\\n  display: grid;\\n  gap: 1.2mm;\\n}\\n\\n.cv-row {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  gap: 0 4mm;\\n  align-items: baseline;\\n  break-inside: avoid;\\n}\\n\\n.cv-row__main b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-row__note {\\n  grid-column: 1 / -1;\\n  font-size: 9.3pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-clients {\\n  display: flex;\\n  flex-wrap: wrap;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-clients span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-proj {\\n  break-inside: avoid;\\n}\\n\\n.cv-proj + .cv-proj {\\n  margin-top: 1.8mm;\\n}\\n\\n.cv-proj__name {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-proj__tech {\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n  white-space: nowrap;\\n}\\n\\n/* Closing columns: education, languages, publications */\\n.cv-cols {\\n  display: grid;\\n  grid-template-columns: 1.15fr 0.85fr 1.3fr;\\n  gap: 0 6mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-small {\\n  font-size: 9.4pt;\\n}\\n\\n.cv-small b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-muted {\\n  color: var(--cv-muted);\\n}\\n\\n/* An owner placeholder still to fill: highlighted on screen previews, plain in print. */\\n.cv-ph {\\n  padding: 0 0.6mm;\\n  border-radius: 0.6mm;\\n  background: #fbebcf;\\n  color: #784708;\\n  font-weight: 700;\\n  white-space: nowrap;\\n}\\n\\n/* \\"Experience, continued\\" (pnpm build:resumes): starts the page an Experience section runs onto. */\\n.cv-continued {\\n  break-before: page;\\n}\\n\\n@media print {\\n  html {\\n    background: none;\\n  }\\n\\n  .cv-doc {\\n    width: auto;\\n    min-height: 0;\\n    margin: 0;\\n    padding: 0;\\n    box-shadow: none;\\n    border-top: 0;\\n  }\\n\\n  .cv-ph {\\n    padding: 0;\\n    background: none;\\n    color: inherit;\\n    font-weight: inherit;\\n  }\\n}\\n@page{@top-left{content:\\"Odunayo Mohammed · Fullstack Software Engineer résumé\\"}@bottom-left{content:\\"Odunayo Mohammed · Fullstack Software Engineer\\"}}@page:first{@top-left{content:none}}</style>\\n</head>\\n<body>\\n<article class=\\"cv-doc\\" aria-label=\\"Fullstack Software Engineer résumé\\">\\n<header class=\\"cv-head\\"><div><h1 class=\\"cv-name\\">Odunayo Mohammed</h1><p class=\\"cv-role\\">Fullstack Software Engineer · CTO</p></div>\\n<div class=\\"cv-contact\\"><p class=\\"cv-contact__line\\"><span>Lagos, Nigeria</span><span><a href=\\"tel:+2347066780373\\">+234 706 678 0373</a></span><span><a href=\\"mailto:factman60@gmail.com\\">factman60@gmail.com</a></span></p><p class=\\"cv-contact__line\\"><span><a href=\\"https://www.linkedin.com/in/mohammed-odunayo\\">linkedin.com/in/mohammed-odunayo</a></span><span><a href=\\"https://github.com/factman\\">github.com/factman</a></span><span><a href=\\"https://www.factman.dev\\">factman.dev</a></span></p></div></header>\\n<section class=\\"cv-sec cv-sec--profile\\"><h2 class=\\"cv-h\\">Profile</h2>\\n<p class=\\"cv-summary\\">Fullstack software engineer and technology leader with 13+ years of experience designing, building and shipping web, mobile and payment products. Works end to end in TypeScript: Angular, React and Next.js interfaces, Node.js and PHP services, and the data, cloud and CI/CD behind them. Currently CTO at Simple Finance and co-founder of ETeam Technology, leading teams that ship every week across fintech, marketplaces and SaaS.</p>\\n</section>\\n<section class=\\"cv-sec cv-sec--skills\\"><h2 class=\\"cv-h\\">Core skills</h2>\\n<dl class=\\"cv-skills\\"><dt>Languages</dt><dd>TypeScript, JavaScript (ES6+), PHP, Python, Java, C++, SQL</dd><dt>Frontend</dt><dd>Angular, React, Next.js, Material UI, HTML5, CSS3 / Sass, accessibility, SEO and web performance</dd><dt>Backend &amp; APIs</dt><dd>Node.js, Express.js, REST API design, authentication, payment integrations</dd><dt>Data</dt><dd>PostgreSQL, MySQL, MongoDB, Elasticsearch, Firebase</dd><dt>Cloud &amp; delivery</dt><dd>Docker, AWS, Microsoft Azure, Google Cloud, Vercel, Jenkins, GitHub Actions, Git</dd><dt>Leadership</dt><dd>Architecture and technical strategy, hiring and mentoring, agile delivery, A/B experimentation</dd></dl>\\n</section>\\n<section class=\\"cv-sec cv-sec--experience\\"><h2 class=\\"cv-h\\">Experience</h2>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Simple Finance Company Limited</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Jan 2024 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Lead the technology team and strategy, aligning engineering roadmaps with the company’s growth targets.</li><li>Architect and oversee the company’s web platform and APIs in Angular, Node.js and TypeScript, serving its customers.</li><li>Selected and deployed new systems and infrastructure that improved operational efficiency by streamlining core workflows.</li><li>Deliver technology projects to scope, schedule and budget in partnership with senior leadership.</li></ul></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Jan 2023</span></div>\\n<ul class=\\"cv-list\\"><li>Led the technology team and strategy; chose and rolled out the core systems and infrastructure the business runs on.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · Angular · Node.js · TypeScript · PostgreSQL · Cloud</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">ETeam Technology</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">CTO &amp; Co-Founder</span><span class=\\"cv-job__dates\\">May 2017 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Co-founded the company; own the technology vision, budget and delivery across software development, architecture, QA, operations and security.</li><li>Lead a team of engineers building web, mobile and payment products for clients including SunTrust Bank, Gifti App and AirtimeFlip.</li><li>Set the engineering standards (code review, testing, CI/CD, releases) used on client projects from concept to production.</li><li>Hire, onboard and mentor engineers, growing developers into senior and lead roles.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · Angular · React · Node.js · PHP · React Native · AWS</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Mazadat</span><span class=\\"cv-org__meta\\">Cairo, Egypt</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Frontend Lead Engineer</span><span class=\\"cv-job__dates\\">Oct 2023 – Mar 2024</span></div>\\n<ul class=\\"cv-list\\"><li>Led frontend strategy and technical direction for the marketplace web platform; mentored and onboarded engineers.</li><li>Streamlined development with cross-functional teams, raising delivery efficiency by removing workflow bottlenecks.</li></ul></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Senior Frontend Engineer</span><span class=\\"cv-job__dates\\">Apr 2023 – Oct 2023</span></div>\\n<ul class=\\"cv-list\\"><li>Built React and ES6 features in a cross-functional mission team; designed, launched and iterated on A/B experiments.</li><li>Improved SEO and load times with lightweight pages built on modern design patterns for search and speed.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · React · ES6 · Elasticsearch · MongoDB · Azure · Docker · Jenkins</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Travoofy</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Aug 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Led technology strategy and the engineering team for the travel platform; evaluated and deployed new systems that improved efficiency.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Investa.ng</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Engineering Manager</span><span class=\\"cv-job__dates\\">Jan 2021 – Jan 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Managed engineering in line with growth targets; delivered projects on time and on budget and supported other departments with technical expertise.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">386konsult</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Jan 2021 – Mar 2021</span></div>\\n<ul class=\\"cv-list\\"><li>Defined the strategy for using technology efficiently, profitably and securely; evaluated and deployed new systems.</li></ul></div>\\n</section>\\n</section>\\n<section class=\\"cv-sec cv-sec--earlier\\"><h2 class=\\"cv-h\\">Earlier experience</h2>\\n<div class=\\"cv-rows\\"><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Information Technology Support Specialist</b>, Afe Babalola University</span><span class=\\"cv-row__dates\\">2018 – Oct 2020</span><span class=\\"cv-row__note\\">Hardware, software and systems support for faculty, staff and students; evaluated and deployed new systems with vendors.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Information Technology Consultant</b>, Peace Mass Transit</span><span class=\\"cv-row__dates\\">Jul 2020 – Aug 2020</span><span class=\\"cv-row__note\\">Advised on new technology systems and resolved technical issues.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Senior Full Stack Developer</b>, Nano Blockchain Ltd</span><span class=\\"cv-row__dates\\">Jun 2018 – Nov 2018</span><span class=\\"cv-row__note\\">Angular, Material UI and React frontends; Node.js and PHP backends.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Web Developer and Designer</b>, JIT Solutions</span><span class=\\"cv-row__dates\\">Jan 2013 – Dec 2017</span><span class=\\"cv-row__note\\">Designed and built client websites with HTML, CSS and JavaScript.</span></div></div>\\n</section>\\n<section class=\\"cv-sec cv-sec--clients\\"><h2 class=\\"cv-h\\">Companies and clients</h2>\\n<p class=\\"cv-clients\\"><span>SunTrust Bank</span><span>Gifti App</span><span>AirtimeFlip</span><span>Appiawave</span><span>Internopay</span><span>Circo</span><span>Cloudax</span></p>\\n</section>\\n<section class=\\"cv-sec cv-sec--projects\\"><h2 class=\\"cv-h\\">Selected projects</h2>\\n<div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Factman portfolio</span><span class=\\"cv-proj__tech\\">Angular · SSG · TypeScript · GitHub Actions</span></div><p>This portfolio: statically generated Angular site on a custom design system, with build-time PDF résumés and consent-gated analytics.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Covid-19 Daily Update API</span><span class=\\"cv-proj__tech\\">Node.js · Express.js · REST</span></div><p>Open-source API serving daily COVID-19 figures to the mobile app and public clients.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">GraphUI</span><span class=\\"cv-proj__tech\\">JavaScript · CSS3</span></div><p>A JavaScript extension for plotting graphs on any website, drawn as SVG.</p></div>\\n</section>\\n<div class=\\"cv-cols\\"><section class=\\"cv-sec cv-sec--education\\"><h2 class=\\"cv-h\\">Education</h2>\\n<p class=\\"cv-small\\"><b>Computer Software Engineering</b><br>FirstMark Innovation School of Technology<br><span class=\\"cv-muted\\">2013 – 2015</span></p>\\n</section><section class=\\"cv-sec cv-sec--languages\\"><h2 class=\\"cv-h\\">Languages</h2>\\n<p class=\\"cv-small\\"><b>English</b> <span class=\\"cv-muted\\">· Professional working</span><br><b>Yoruba</b> <span class=\\"cv-muted\\">· Native</span></p>\\n</section><section class=\\"cv-sec cv-sec--publications\\"><h2 class=\\"cv-h\\">Publications</h2>\\n<p class=\\"cv-small\\"><b>Coronavirus Daily Update</b> <span class=\\"cv-muted\\">· mobile app, 2020</span><br><b>Covid-19 Daily Update API</b> <span class=\\"cv-muted\\">· open source, 2020</span><br><b>GraphUI</b> <span class=\\"cv-muted\\">· open source, 2019</span><br><span class=\\"cv-muted\\">Featured: \\"Nigerian engineer launches Coronavirus Daily Update mobile app\\"</span></p>\\n</section></div>\\n</article>\\n</body>\\n</html>\\n"
`;

exports[`the résumé template > mobile: matches its snapshot 1`] = `
"<!doctype html>\\n<html lang=\\"en\\">\\n<head>\\n<meta charset=\\"utf-8\\">\\n<title>Odunayo Mohammed · Mobile Developer</title>\\n<meta name=\\"author\\" content=\\"Odunayo Mohammed\\">\\n<meta name=\\"robots\\" content=\\"noindex\\">\\n<style>/* The résumé layout (ETE-107, ported from the canvas's resume.css, ETE-223).\\n   A4, 15 / 17 / 16 mm margins. Carlito (metric-compatible with Calibri) for text, Caladea\\n   (metric-compatible with Cambria) for headings; both self-hosted, with system fallbacks.\\n   Fixed colours: a résumé always prints light. One column of real text, so it extracts in reading\\n   order. In print, the page boxes carry the footer (name, role, \\"Page x of y\\") on every page and\\n   the running header from page 2; the template writes their text (pageCss in template.ts). */\\n@page {\\n  size: a4;\\n  margin: 15mm 17mm 16mm;\\n\\n  @top-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-left {\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n\\n  @bottom-right {\\n    content: 'Page ' counter(page) ' of ' counter(pages);\\n    vertical-align: middle;\\n    font:\\n      400 8pt/1 Carlito,\\n      Calibri,\\n      sans-serif;\\n    color: #64768f;\\n  }\\n}\\n\\n/* The first page opens with the name in full; the running header starts on page 2. */\\n@page :first {\\n  @top-left {\\n    content: none;\\n  }\\n}\\n\\n:root {\\n  --cv-ink: #07203f;\\n  --cv-text: #1f2b40;\\n  --cv-muted: #4a5a72;\\n  --cv-faint: #64768f;\\n  --cv-rule: #d3dce9;\\n  --cv-accent: #0b4c9e;\\n}\\n\\nhtml {\\n  background: #dde5ef;\\n}\\n\\nbody {\\n  margin: 0;\\n}\\n\\n.cv-doc {\\n  box-sizing: border-box;\\n  width: 210mm;\\n  min-height: 297mm;\\n  margin: 32px auto;\\n  padding: 15mm 17mm 16mm;\\n  background: #fff;\\n  color: var(--cv-text);\\n  box-shadow:\\n    0 16px 40px -8px rgb(7 32 63 / 18%),\\n    0 2px 8px rgb(7 32 63 / 8%);\\n  border-top: 2.2mm solid var(--cv-accent);\\n  font:\\n    400 10pt/1.38 Carlito,\\n    Calibri,\\n    'Helvetica Neue',\\n    Arial,\\n    sans-serif;\\n  -webkit-font-smoothing: antialiased;\\n  text-rendering: optimizelegibility;\\n}\\n\\n.cv-doc p,\\n.cv-doc ul,\\n.cv-doc h1,\\n.cv-doc h2,\\n.cv-doc h3,\\n.cv-doc dl {\\n  margin: 0;\\n}\\n\\n/* Header */\\n.cv-head {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  align-items: end;\\n  gap: 2mm 8mm;\\n  padding-bottom: 3.2mm;\\n  border-bottom: 0.75pt solid var(--cv-accent);\\n}\\n\\n.cv-name {\\n  font:\\n    700 25pt/1.05 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.2pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-role {\\n  margin-top: 1.4mm;\\n  font:\\n    700 10.5pt/1.3 Carlito,\\n    Calibri,\\n    Arial,\\n    sans-serif;\\n  letter-spacing: 0.9pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n}\\n\\n.cv-contact {\\n  grid-column: 1 / -1;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5mm;\\n  font-size: 9.2pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-contact__line {\\n  display: flex;\\n  flex-wrap: wrap;\\n}\\n\\n.cv-contact__line span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-contact a {\\n  color: inherit;\\n  text-decoration: none;\\n}\\n\\n/* Sections */\\n.cv-sec {\\n  margin-top: 4.2mm;\\n}\\n\\n.cv-h {\\n  display: flex;\\n  align-items: center;\\n  gap: 3mm;\\n  margin-bottom: 2.2mm;\\n  font:\\n    700 10.5pt/1.2 Caladea,\\n    Cambria,\\n    Georgia,\\n    serif;\\n  letter-spacing: 0.8pt;\\n  text-transform: uppercase;\\n  color: var(--cv-accent);\\n  break-after: avoid;\\n}\\n\\n.cv-h::after {\\n  content: '';\\n  flex: 1;\\n  height: 0;\\n  border-top: 0.5pt solid var(--cv-rule);\\n}\\n\\n.cv-summary {\\n  font-size: 10.3pt;\\n  line-height: 1.45;\\n  text-align: justify;\\n  hyphens: auto;\\n}\\n\\n.cv-skills {\\n  display: grid;\\n  grid-template-columns: 31mm 1fr;\\n  gap: 1.1mm 4mm;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-skills dt {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-skills dd {\\n  margin: 0;\\n}\\n\\n/* Experience */\\n.cv-org {\\n  margin-top: 2.8mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-org:first-of-type {\\n  margin-top: 0;\\n}\\n\\n.cv-org__head,\\n.cv-job__head,\\n.cv-proj__head {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  gap: 4mm;\\n}\\n\\n.cv-org__name {\\n  font-weight: 700;\\n  font-size: 10.6pt;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-org__meta,\\n.cv-job__dates,\\n.cv-row__dates {\\n  font-size: 9pt;\\n  color: var(--cv-muted);\\n  white-space: nowrap;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.cv-job {\\n  margin-top: 1.2mm;\\n}\\n\\n.cv-job__title {\\n  font-style: italic;\\n  font-weight: 700;\\n  color: var(--cv-accent);\\n  font-size: 10pt;\\n}\\n\\n.cv-list {\\n  list-style: none;\\n  padding: 0;\\n  margin-top: 0.9mm;\\n}\\n\\n.cv-list li {\\n  position: relative;\\n  padding-left: 4mm;\\n  margin-top: 0.55mm;\\n}\\n\\n.cv-list li::before {\\n  content: '';\\n  position: absolute;\\n  left: 0.6mm;\\n  top: 0.62em;\\n  width: 1.3mm;\\n  height: 1.3mm;\\n  background: var(--cv-accent);\\n  transform: rotate(45deg);\\n}\\n\\n.cv-stack {\\n  margin-top: 0.7mm;\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-stack b {\\n  font-weight: 700;\\n  color: var(--cv-muted);\\n}\\n\\n/* Earlier roles, clients and projects */\\n.cv-rows {\\n  display: grid;\\n  gap: 1.2mm;\\n}\\n\\n.cv-row {\\n  display: grid;\\n  grid-template-columns: 1fr auto;\\n  gap: 0 4mm;\\n  align-items: baseline;\\n  break-inside: avoid;\\n}\\n\\n.cv-row__main b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-row__note {\\n  grid-column: 1 / -1;\\n  font-size: 9.3pt;\\n  color: var(--cv-muted);\\n}\\n\\n.cv-clients {\\n  display: flex;\\n  flex-wrap: wrap;\\n  font-size: 9.6pt;\\n}\\n\\n.cv-clients span + span::before {\\n  content: '·';\\n  margin: 0 2.2mm;\\n  color: var(--cv-faint);\\n}\\n\\n.cv-proj {\\n  break-inside: avoid;\\n}\\n\\n.cv-proj + .cv-proj {\\n  margin-top: 1.8mm;\\n}\\n\\n.cv-proj__name {\\n  font-weight: 700;\\n  color: var(--cv-ink);\\n}\\n\\n.cv-proj__tech {\\n  font-size: 8.8pt;\\n  color: var(--cv-faint);\\n  white-space: nowrap;\\n}\\n\\n/* Closing columns: education, languages, publications */\\n.cv-cols {\\n  display: grid;\\n  grid-template-columns: 1.15fr 0.85fr 1.3fr;\\n  gap: 0 6mm;\\n  break-inside: avoid;\\n}\\n\\n.cv-small {\\n  font-size: 9.4pt;\\n}\\n\\n.cv-small b {\\n  color: var(--cv-ink);\\n}\\n\\n.cv-muted {\\n  color: var(--cv-muted);\\n}\\n\\n/* An owner placeholder still to fill: highlighted on screen previews, plain in print. */\\n.cv-ph {\\n  padding: 0 0.6mm;\\n  border-radius: 0.6mm;\\n  background: #fbebcf;\\n  color: #784708;\\n  font-weight: 700;\\n  white-space: nowrap;\\n}\\n\\n/* \\"Experience, continued\\" (pnpm build:resumes): starts the page an Experience section runs onto. */\\n.cv-continued {\\n  break-before: page;\\n}\\n\\n@media print {\\n  html {\\n    background: none;\\n  }\\n\\n  .cv-doc {\\n    width: auto;\\n    min-height: 0;\\n    margin: 0;\\n    padding: 0;\\n    box-shadow: none;\\n    border-top: 0;\\n  }\\n\\n  .cv-ph {\\n    padding: 0;\\n    background: none;\\n    color: inherit;\\n    font-weight: inherit;\\n  }\\n}\\n@page{@top-left{content:\\"Odunayo Mohammed · Mobile Developer résumé\\"}@bottom-left{content:\\"Odunayo Mohammed · Mobile Developer\\"}}@page:first{@top-left{content:none}}</style>\\n</head>\\n<body>\\n<article class=\\"cv-doc\\" aria-label=\\"Mobile Developer résumé\\">\\n<header class=\\"cv-head\\"><div><h1 class=\\"cv-name\\">Odunayo Mohammed</h1><p class=\\"cv-role\\">Mobile Developer · React Native · Flutter · Ionic</p></div>\\n<div class=\\"cv-contact\\"><p class=\\"cv-contact__line\\"><span>Lagos, Nigeria</span><span><a href=\\"tel:+2347066780373\\">+234 706 678 0373</a></span><span><a href=\\"mailto:factman60@gmail.com\\">factman60@gmail.com</a></span></p><p class=\\"cv-contact__line\\"><span><a href=\\"https://www.linkedin.com/in/mohammed-odunayo\\">linkedin.com/in/mohammed-odunayo</a></span><span><a href=\\"https://github.com/factman\\">github.com/factman</a></span><span><a href=\\"https://www.factman.dev\\">factman.dev</a></span></p></div></header>\\n<section class=\\"cv-sec cv-sec--profile\\"><h2 class=\\"cv-h\\">Profile</h2>\\n<p class=\\"cv-summary\\">Mobile developer with 13+ years in software and cross-platform mobile experience since 2018, building Android and iOS apps with React Native, Flutter and Ionic. Takes apps from prototype to App Store and Google Play release, backed by Firebase and REST APIs, with a strong web and backend foundation in TypeScript, Angular and Node.js. Creator of the Coronavirus Daily Update app, covered by the Nigerian tech press at launch.</p>\\n</section>\\n<section class=\\"cv-sec cv-sec--skills\\"><h2 class=\\"cv-h\\">Core skills</h2>\\n<dl class=\\"cv-skills\\"><dt>Mobile</dt><dd>React Native, Flutter (since 2023), Ionic (since 2018), Android and iOS builds</dd><dt>Languages</dt><dd>TypeScript, JavaScript (ES6+), Dart, Java</dd><dt>App backends</dt><dd>Firebase, Node.js, Express.js, REST APIs, authentication, payment integrations</dd><dt>Release</dt><dd>App Store Connect, Google Play Console, versioning and staged roll-outs, CI/CD</dd><dt>UI &amp; quality</dt><dd>Component design systems, Material UI, responsive layouts, accessibility, code review, testing</dd><dt>Also</dt><dd>Angular, React, Next.js, PostgreSQL, MongoDB, Docker, Git</dd></dl>\\n</section>\\n<section class=\\"cv-sec cv-sec--experience\\"><h2 class=\\"cv-h\\">Experience</h2>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">ETeam Technology</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">CTO &amp; Co-Founder</span><span class=\\"cv-job__dates\\">May 2017 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Lead mobile delivery for client apps built with React Native, Flutter and Ionic, from prototype to App Store and Google Play release across several apps.</li><li>Define mobile architecture: shared TypeScript and Dart codebases, REST and Firebase backends, and automated release pipelines.</li><li>Lead a team of engineers delivering mobile, web and payment products for clients including Gifti App, AirtimeFlip and SunTrust Bank.</li><li>Own QA and release management, keeping store ratings at a high level and crash-free sessions above target.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · React Native · Flutter · Ionic · Firebase · Node.js · TypeScript</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Simple Finance Company Limited</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Jan 2024 – Present</span></div>\\n<ul class=\\"cv-list\\"><li>Set the technology strategy and lead delivery of the company’s customer-facing web and mobile products and APIs.</li><li>Selected and deployed new systems and infrastructure that improved operational efficiency by streamlining core workflows.</li></ul></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Jan 2023</span></div>\\n<ul class=\\"cv-list\\"><li>Led the technology team and strategy; chose and rolled out the company’s core systems.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Mazadat</span><span class=\\"cv-org__meta\\">Cairo, Egypt</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Frontend Lead Engineer · Senior Frontend Engineer</span><span class=\\"cv-job__dates\\">Apr 2023 – Mar 2024</span></div>\\n<ul class=\\"cv-list\\"><li>Led frontend strategy for the marketplace platform in React and ES6; mentored and onboarded engineers.</li><li>Designed, launched and iterated on A/B experiments, and improved SEO and load times with lightweight pages.</li></ul></div>\\n<p class=\\"cv-stack\\"><b>Stack</b> · React · ES6 · Elasticsearch · Azure · Docker</p>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Travoofy</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Chief Technology Officer</span><span class=\\"cv-job__dates\\">Dec 2021 – Aug 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Led technology strategy and the engineering team for the travel booking platform across web and mobile.</li></ul></div>\\n</section>\\n<section class=\\"cv-org\\">\\n<div class=\\"cv-org__head\\"><span class=\\"cv-org__name\\">Investa.ng</span><span class=\\"cv-org__meta\\">Lagos, Nigeria</span></div>\\n<div class=\\"cv-job\\"><div class=\\"cv-job__head\\"><span class=\\"cv-job__title\\">Engineering Manager</span><span class=\\"cv-job__dates\\">Jan 2021 – Jan 2022</span></div>\\n<ul class=\\"cv-list\\"><li>Managed engineering in line with growth targets and delivered projects on time and on budget.</li></ul></div>\\n</section>\\n</section>\\n<section class=\\"cv-sec cv-sec--earlier\\"><h2 class=\\"cv-h\\">Earlier experience</h2>\\n<div class=\\"cv-rows\\"><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Chief Technology Officer</b>, 386konsult</span><span class=\\"cv-row__dates\\">Jan 2021 – Mar 2021</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Information Technology Support Specialist</b>, Afe Babalola University</span><span class=\\"cv-row__dates\\">2018 – Oct 2020</span><span class=\\"cv-row__note\\">Hardware, software and systems support for faculty, staff and students; evaluated and deployed new systems with vendors.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Information Technology Consultant</b>, Peace Mass Transit</span><span class=\\"cv-row__dates\\">Jul 2020 – Aug 2020</span><span class=\\"cv-row__note\\">Advised on new technology systems and resolved technical issues.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Senior Full Stack Developer</b>, Nano Blockchain Ltd</span><span class=\\"cv-row__dates\\">Jun 2018 – Nov 2018</span><span class=\\"cv-row__note\\">Angular, Material UI and React frontends; Node.js and PHP backends.</span></div><div class=\\"cv-row\\"><span class=\\"cv-row__main\\"><b>Web Developer and Designer</b>, JIT Solutions</span><span class=\\"cv-row__dates\\">Jan 2013 – Dec 2017</span><span class=\\"cv-row__note\\">Designed and built client websites with HTML, CSS and JavaScript.</span></div></div>\\n</section>\\n<section class=\\"cv-sec cv-sec--clients\\"><h2 class=\\"cv-h\\">Companies and clients</h2>\\n<p class=\\"cv-clients\\"><span>SunTrust Bank</span><span>Gifti App</span><span>AirtimeFlip</span><span>Appiawave</span><span>Internopay</span><span>Circo</span><span>Cloudax</span></p>\\n</section>\\n<section class=\\"cv-sec cv-sec--projects\\"><h2 class=\\"cv-h\\">Selected projects</h2>\\n<div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Coronavirus Daily Update</span><span class=\\"cv-proj__tech\\">React Native · Android · iOS</span></div><p>Creator. App with daily COVID-19 case updates for Nigeria, covered in the Nigerian tech press at launch and free to use.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Covid-19 Daily Update API</span><span class=\\"cv-proj__tech\\">Node.js · Express.js · REST</span></div><p>Open-source API behind the app, serving daily figures to the app and other clients.</p></div><div class=\\"cv-proj\\"><div class=\\"cv-proj__head\\"><span class=\\"cv-proj__name\\">Gifti App</span><span class=\\"cv-proj__tech\\">iOS</span></div><p>Client mobile app delivered by ETeam Technology, from build to App Store release.</p></div>\\n</section>\\n<div class=\\"cv-cols\\"><section class=\\"cv-sec cv-sec--education\\"><h2 class=\\"cv-h\\">Education</h2>\\n<p class=\\"cv-small\\"><b>Computer Software Engineering</b><br>FirstMark Innovation School of Technology<br><span class=\\"cv-muted\\">2013 – 2015</span></p>\\n</section><section class=\\"cv-sec cv-sec--languages\\"><h2 class=\\"cv-h\\">Languages</h2>\\n<p class=\\"cv-small\\"><b>English</b> <span class=\\"cv-muted\\">· Professional working</span><br><b>Yoruba</b> <span class=\\"cv-muted\\">· Native</span></p>\\n</section><section class=\\"cv-sec cv-sec--publications\\"><h2 class=\\"cv-h\\">Publications</h2>\\n<p class=\\"cv-small\\"><b>Coronavirus Daily Update</b> <span class=\\"cv-muted\\">· mobile app, 2020</span><br><b>Covid-19 Daily Update API</b> <span class=\\"cv-muted\\">· open source, 2020</span><br><b>GraphUI</b> <span class=\\"cv-muted\\">· open source, 2019</span><br><span class=\\"cv-muted\\">Featured: \\"Nigerian engineer launches Coronavirus Daily Update mobile app\\"</span></p>\\n</section></div>\\n</article>\\n</body>\\n</html>\\n"
`;
